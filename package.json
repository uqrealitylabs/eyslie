{
  "name": "@uqrealitylabs/eyslie",
  "version": "0.4.0",
  "description": "Expressive living text eyes, moods, winks, blush, bubbles, and reactions for React.",
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "npm@11.12.1",
  "sideEffects": [
    "src/styles/eyslie.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/eyslie.css"
  },
  "scripts": {
    "check:workflows": "node tools/scripts/assert-actions-pinned.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "npm run test:coverage",
    "test:unit": "vitest run --config tools/config/vitest.config.ts",
    "test:ci": "npm run test:ci:base && npm run test:consumer",
    "test:ci:base": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run demo:build && npm run test:demo",
    "test:coverage": "vitest run --config tools/config/vitest.config.ts --coverage.enabled true",
    "prebuild": "rm -rf dist",
    "build": "tsc -p tools/config/tsconfig.build.json",
    "demo:dev": "npm run build && vite --config tools/config/demo-vite.config.ts",
    "demo:build": "npm run build && npm run demo:typecheck:built && vite build --config tools/config/demo-vite.config.ts && cp examples/demo/src/assets/OFL.txt demo-dist/OFL.txt",
    "demo:preview": "npm run demo:build && vite preview --config tools/config/demo-vite.config.ts",
    "demo:typecheck:built": "tsc --noEmit --project tools/config/tsconfig.demo.json",
    "test:demo": "node tools/scripts/demo/validate-demo.ts",
    "test:consumer": "node tools/scripts/consumer-smoke.ts",
    "security:audit": "npm audit --audit-level=moderate",
    "security:osv": "node tools/scripts/security/osv-audit.ts",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uqrealitylabs/eyslie.git"
  },
  "bugs": {
    "url": "https://github.com/uqrealitylabs/eyslie/issues"
  },
  "homepage": "https://github.com/uqrealitylabs/eyslie#readme",
  "keywords": [
    "react",
    "ui",
    "animation",
    "eyes",
    "living-text"
  ],
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-test-renderer": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "unicode-segmenter": "0.17.3"
  }
}
